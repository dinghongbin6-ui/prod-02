aws_region   = "ap-northeast-1"
project_name = "enterprise-ai"

# Replace with your current public IPv4 address, always using /32.
admin_cidr = "203.0.113.10/32"

# Replace with an existing EC2 key pair name in this region.
key_name = "replace-with-existing-key-pair"

# Replace with the company's approved public egress/client CIDRs.
web_ingress_cidrs = ["203.0.113.0/24"]

linux_instance_type   = "t3.medium"
windows_instance_type = "g4dn.xlarge"